{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pixi run test)",
      "Bash(pixi run test *)",
      "Bash(pixi run lint)",
      "Bash(pre-commit run *)",
      "Bash(um-vpn status)"
    ],
    "deny": [
      "Bash(um-vpn)",
      "Bash(um-vpn on)",
      "Bash(um-vpn on *)",
      "Bash(um-vpn off)",
      "Bash(um-vpn off *)",
      "Bash(um-vpn forget)",
      "Bash(um-vpn forget *)",
      "Bash(um-vpn remember)",
      "Bash(um-vpn remember *)",
      "Bash(secret-tool)",
      "Bash(secret-tool *)",
      "Bash(./um_vpn.py)",
      "Bash(./um_vpn.py *)",
      "Bash(nmcli connection up *)",
      "Bash(nmcli connection down *)",
      "Bash(nmcli connection delete *)",
      "Read(~/.local/share/um-vpn/**)"
    ]
  }
}
