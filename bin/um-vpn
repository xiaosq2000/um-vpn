#!/usr/bin/env bash
# UM SSL VPN toggle.
#
#   um-vpn              toggle: connect if down, disconnect if up
#   um-vpn on           connect, reusing the cached cookie while it still works
#   um-vpn off          disconnect
#   um-vpn status       show tunnel state
#   um-vpn renew        force a fresh browser login, then connect
#   um-vpn credentials  save the UMPASS ID + password for the sign-in form
#   um-vpn uninstall    remove the command, the cached cookie and the profile
#
# The portal federates to ADFS/SAML, so openconnect cannot log in by itself.
# browser-login.py opens a Chrome window for UMPASS + Duo and lifts the DSID
# session cookie out of it over the DevTools protocol -- no DevTools panel, no
# pasting.
#
# `um-vpn credentials` puts the UMPASS ID and password in the login keyring;
# the sign-in form is then filled and submitted for you, so a login costs one
# Duo tap and nothing typed. `um-vpn credentials clear` forgets them again.
#
# Optional environment overrides:
#
#   UM_VPN_PORTAL_URL     portal URL (default https://sslvpn.um.edu.mo)
#   UM_VPN_COOKIE_DOMAIN  domain the cookie must belong to (default: the
#                         host part of the portal URL)
#   UM_VPN_LOGIN_DOMAIN   domain allowed to receive the saved credentials
#   UM_VPN_BROWSER        Chromium-family browser to drive
#   UM_VPN_VPNC_SCRIPT    path to vpnc-script
#   UM_VPN_AUTOFILL       'off' to always type the sign-in form yourself
#
# The browser and vpnc-script are probed from the usual paths when unset.
# UM_VPN_LOGIN_DOMAIN defaults to the cookie domain without its leftmost
# label, which is where the portal hands the login off to the IdP.

set -euo pipefail

PORTAL_URL="${UM_VPN_PORTAL_URL:-https://sslvpn.um.edu.mo}"

# Default the cookie domain to the portal URL's host, so pointing this at
# another Juniper/Pulse portal only takes the one override.
COOKIE_DOMAIN="${UM_VPN_COOKIE_DOMAIN:-}"
if [[ -z "$COOKIE_DOMAIN" ]]; then
  COOKIE_DOMAIN="${PORTAL_URL#*://}"
  COOKIE_DOMAIN="${COOKIE_DOMAIN%%/*}"
  COOKIE_DOMAIN="${COOKIE_DOMAIN%%:*}"
fi

# The saved password is typed into pages under this domain and nowhere else,
# so a stray tab left open on the login profile can never be handed it. The
# portal hands off one label up: sslvpn.um.edu.mo -> um.edu.mo.
LOGIN_DOMAIN="${UM_VPN_LOGIN_DOMAIN:-${COOKIE_DOMAIN#*.}}"

# Anything but 'off' leaves autofill on, where it stays inert until
# `um-vpn credentials` has something to fill the form with.
AUTOFILL="${UM_VPN_AUTOFILL:-on}"

# Chromium-family only: the login is driven over the Chrome DevTools Protocol,
# which Firefox does not speak.
BROWSER_CANDIDATES=(
  google-chrome
  google-chrome-stable
  chromium
  chromium-browser
)

# Distributions disagree about where openconnect's vpnc-script lands.
VPNC_SCRIPT_CANDIDATES=(
  /usr/share/vpnc-scripts/vpnc-script
  /etc/vpnc/vpnc-script
  /usr/share/vpnc/vpnc-script
  /usr/local/etc/vpnc/vpnc-script
  /opt/homebrew/etc/vpnc/vpnc-script
)

# Resolved lazily in cmd_on: status and --help need neither.
VPNC_SCRIPT=""

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/um-vpn"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/um-vpn"
COOKIE_FILE="$STATE_DIR/cookie"
PID_FILE="$STATE_DIR/tunnel.pid"
LOG_FILE="$STATE_DIR/tunnel.log"
BROWSER_PROFILE="$DATA_DIR/chrome"

SELF="$(readlink -f "$0")"
LOGIN_HELPER="$(dirname "$SELF")/../libexec/um-vpn/browser-login.py"

die() { printf 'um-vpn: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

# --- host discovery -------------------------------------------------------

find_browser() {
  local candidate
  if [[ -n "${UM_VPN_BROWSER:-}" ]]; then
    command -v "$UM_VPN_BROWSER" >/dev/null ||
      die "browser not found: $UM_VPN_BROWSER"
    printf '%s' "$UM_VPN_BROWSER"
    return 0
  fi
  for candidate in "${BROWSER_CANDIDATES[@]}"; do
    if command -v "$candidate" >/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  die "no Chromium-family browser found; set UM_VPN_BROWSER"
}

find_vpnc_script() {
  local candidate
  if [[ -n "${UM_VPN_VPNC_SCRIPT:-}" ]]; then
    [[ -x "$UM_VPN_VPNC_SCRIPT" ]] ||
      die "vpnc-script is not executable: $UM_VPN_VPNC_SCRIPT"
    printf '%s' "$UM_VPN_VPNC_SCRIPT"
    return 0
  fi
  for candidate in "${VPNC_SCRIPT_CANDIDATES[@]}"; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  die "vpnc-script not found; install vpnc-scripts or set UM_VPN_VPNC_SCRIPT"
}

# --- tunnel state ---------------------------------------------------------

# kill -0 reports EPERM for a root-owned process, so probe /proc instead.
tunnel_pid() {
  local pid
  [[ -r "$PID_FILE" ]] || return 1
  pid="$(<"$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -d "/proc/$pid" ]] || return 1
  [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == openconnect ]] || return 1
  printf '%s' "$pid"
}

tunnel_addr() {
  ip -o -4 addr show 2>/dev/null |
    awk '$2 ~ /^(tun|vpn)/ { print $2 " " $4; exit }'
}

# --- privileges -----------------------------------------------------------

# Take the sudo prompt up front so it never appears underneath the login window.
require_sudo() {
  sudo -v || die "sudo authentication failed"
}

# --- credentials ----------------------------------------------------------

# Attributes that identify our two items in the login keyring.
KEYRING_ATTRS=(service um-vpn)

# ID and password are stored as two items so both come back through
# `secret-tool lookup`, which prints the secret and nothing else -- `search`
# would put the password on stdout beside the attributes it was asked for.
#
# Always succeeds and prints nothing when there is no keyring, no item, or no
# secret-tool, so callers can test the value instead of the exit status.
keyring_get() {
  command -v secret-tool >/dev/null || return 0
  secret-tool lookup "${KEYRING_ATTRS[@]}" field "$1" 2>/dev/null || true
}

# The value arrives as a function argument and leaves through a builtin, so
# it never reaches the process table on its way to the keyring.
keyring_set() {
  printf '%s' "$2" |
    secret-tool store --label="UM VPN (UMPASS $1)" \
      "${KEYRING_ATTRS[@]}" field "$1"
}

# `secret-tool clear` exits 1 when there was nothing to match, which is the
# same outcome we want.
keyring_clear() {
  local field
  for field in username password; do
    secret-tool clear "${KEYRING_ATTRS[@]}" field "$field" 2>/dev/null || true
  done
}

cmd_credentials() {
  local action="${1:-store}" user pass
  command -v secret-tool >/dev/null ||
    die "secret-tool not found; install libsecret-tools"

  case "$action" in
    store)
      [[ -t 0 ]] || die "credentials needs a terminal to read the password"
      read -r -p 'UMPASS ID: ' user || die "aborted"
      [[ -n "$user" ]] || die "no ID given"
      read -rs -p 'UMPASS password: ' pass || die "aborted"
      note ""
      [[ -n "$pass" ]] || die "no password given"
      keyring_set username "$user" || die "could not write to the keyring"
      keyring_set password "$pass" || die "could not write to the keyring"
      note "Saved in the login keyring."
      note "um-vpn fills the sign-in form from now on; Duo is still yours."
      ;;
    clear)
      keyring_clear
      note "Forgot the saved UMPASS credentials."
      ;;
    *)
      die "unknown: um-vpn credentials [store|clear]"
      ;;
  esac
}

# --- cookie ---------------------------------------------------------------

browser_login() {
  local browser user="" pass=""
  local -a cmd
  [[ -r "$LOGIN_HELPER" ]] || die "helper not found: $LOGIN_HELPER"
  browser="$(find_browser)"
  cmd=(
    python3 "$LOGIN_HELPER"
    --browser "$browser"
    --profile "$BROWSER_PROFILE"
    --url "$PORTAL_URL"
    --cookie DSID
    --domain "$COOKIE_DOMAIN"
    --login-domain "$LOGIN_DOMAIN"
  )

  if [[ "$AUTOFILL" != off ]]; then
    user="$(keyring_get username)"
  fi
  # Each lookup is a D-Bus round trip, so the password is only asked for once
  # an ID has proved there is something saved to go with it.
  if [[ -n "$user" ]]; then
    pass="$(keyring_get password)"
  fi

  # NUL-separated on stdin: argv would expose the password in `ps` output,
  # exactly as --cookie would expose the session below.
  if [[ -n "$pass" ]]; then
    printf '%s\0%s' "$user" "$pass" | "${cmd[@]}" --credentials-on-stdin
  else
    "${cmd[@]}"
  fi
}

save_cookie() {
  install -d -m 700 "$STATE_DIR"
  (umask 077; printf '%s\n' "$1" >"$COOKIE_FILE")
}

# --- connect / disconnect -------------------------------------------------

# Feed the cookie on stdin: --cookie would expose the session in `ps` output.
# --no-proxy pins the behaviour sudo's env_reset gives us today, so a local
# http_proxy leaking through env_keep cannot silently reroute the tunnel.
# --non-inter turns any unexpected prompt into a fast, visible failure.
#
# SC2024: the redirect is intentionally the calling shell's, not sudo's -- the
# log lives in the user's own state dir and must stay user-owned.
# shellcheck disable=SC2024
start_tunnel() {
  printf 'DSID=%s\n' "$1" | sudo openconnect \
    --protocol=nc \
    --cookie-on-stdin \
    --no-proxy \
    --non-inter \
    --background \
    --timestamp \
    --pid-file "$PID_FILE" \
    --script "$VPNC_SCRIPT" \
    "$PORTAL_URL" >>"$LOG_FILE" 2>&1
}

cmd_on() {
  local pid dsid
  if pid="$(tunnel_pid)"; then
    note "Already connected (pid $pid)."
    cmd_status
    return 0
  fi

  command -v openconnect >/dev/null || die "openconnect is not installed"
  VPNC_SCRIPT="$(find_vpnc_script)"
  install -d -m 700 "$STATE_DIR" "$DATA_DIR"
  require_sudo

  if [[ -s "$COOKIE_FILE" ]]; then
    note "Trying the cached session cookie..."
    if start_tunnel "$(<"$COOKIE_FILE")"; then
      note "Connected."
      cmd_status
      return 0
    fi
    note "Cached cookie was rejected; a fresh login is needed."
  fi

  dsid="$(browser_login)" || die "could not obtain a DSID cookie"
  [[ -n "$dsid" ]] || die "browser login produced an empty DSID"
  save_cookie "$dsid"

  if start_tunnel "$dsid"; then
    note "Connected."
    cmd_status
    return 0
  fi

  note "--- last lines of $LOG_FILE ---"
  tail -n 15 "$LOG_FILE" >&2 || true
  die "openconnect failed to start the tunnel"
}

cmd_off() {
  local pid
  if ! pid="$(tunnel_pid)"; then
    note "Not connected."
    if [[ -e "$PID_FILE" ]]; then sudo rm -f "$PID_FILE"; fi
    return 0
  fi
  require_sudo
  # One sudo invocation so the whole teardown costs at most one prompt.
  sudo sh -c '
    pid=$1; pidfile=$2
    kill -TERM "$pid" 2>/dev/null
    i=0
    while [ -d "/proc/$pid" ] && [ "$i" -lt 40 ]; do
      sleep 0.25
      i=$((i + 1))
    done
    [ -d "/proc/$pid" ] && kill -KILL "$pid" 2>/dev/null
    rm -f "$pidfile"
    exit 0
  ' sh "$pid" "$PID_FILE"
  note "Disconnected."
}

cmd_renew() {
  if tunnel_pid >/dev/null; then cmd_off; fi
  rm -f "$COOKIE_FILE"
  note "Cached cookie cleared."
  cmd_on
}

cmd_status() {
  local pid addr
  if pid="$(tunnel_pid)"; then
    addr="$(tunnel_addr)"
    printf 'um-vpn: connected (pid %s)%s\n' "$pid" \
      "${addr:+, ${addr%% *} ${addr##* }}"
  else
    printf 'um-vpn: disconnected\n'
  fi
  if [[ -s "$COOKIE_FILE" ]]; then
    printf '  cached cookie: %s (%dm old)\n' "$COOKIE_FILE" \
      "$(( ( $(date +%s) - $(stat -c %Y "$COOKIE_FILE") ) / 60 ))"
  else
    printf '  cached cookie: none\n'
  fi
  printf '  log: %s\n' "$LOG_FILE"
}

# --- uninstall ------------------------------------------------------------

# Abbreviate $HOME so the confirmation listing stays readable at a glance.
abbrev_home() { printf '%s' "${1/#"$HOME"/\~}"; }

# Only symlinks resolving back to this script are ours to delete: a real file
# named um-vpn on PATH belongs to something else, and the clone is never
# touched -- reinstalling is the same one `ln -s` as before.
installed_links() {
  local dir link
  local -a dirs=()
  IFS=: read -r -a dirs <<<"$PATH"
  # The README puts the symlink here, so look even if PATH has moved on --
  # awk then drops the duplicate when PATH already lists it.
  dirs+=("$HOME/.local/bin")
  for dir in "${dirs[@]}"; do
    link="$dir/um-vpn"
    [[ -n "$dir" && -L "$link" ]] || continue
    if [[ "$(readlink -f "$link")" == "$SELF" ]]; then
      printf '%s\n' "$link"
    fi
  done | awk '!seen[$0]++'
}

cmd_uninstall() {
  local link entry path desc line reply size clone width
  local -a links=() entries=()

  mapfile -t links < <(installed_links)

  # One "<path>\t<what it is>" record per line of the listing: keeping the
  # pair in a single element is what stops the two halves drifting apart.
  for link in "${links[@]}"; do
    entries+=("$(abbrev_home "$link")"$'\t'"symlink")
  done
  if [[ -d "$STATE_DIR" ]]; then
    entries+=("$(abbrev_home "$STATE_DIR")"$'\t'"cached cookie, log")
  fi
  if [[ -d "$DATA_DIR" ]]; then
    size="$(du -sh "$DATA_DIR" 2>/dev/null | cut -f1)"
    entries+=("$(abbrev_home "$DATA_DIR")"$'\t'"Chrome profile${size:+, $size}")
  fi
  if [[ -n "$(keyring_get username)" ]]; then
    entries+=("login keyring"$'\t'"saved UMPASS credentials")
  fi

  if (( ${#entries[@]} == 0 )); then
    note "Nothing to remove; um-vpn is not installed for this user."
    return 0
  fi

  [[ -t 0 ]] || die "uninstall needs a terminal to confirm"

  # Pad to the longest path so the listing reads as a column, not a paragraph.
  width=0
  for entry in "${entries[@]}"; do
    path="${entry%%$'\t'*}"
    if (( ${#path} > width )); then width="${#path}"; fi
  done

  clone="$(abbrev_home "$(dirname "$(dirname "$SELF")")")"

  note "This will permanently remove:"
  note ""
  for entry in "${entries[@]}"; do
    path="${entry%%$'\t'*}"
    desc="${entry#*$'\t'}"
    printf -v line '  %-*s  (%s)' "$width" "$path" "$desc"
    note "$line"
  done
  note ""
  if tunnel_pid >/dev/null; then
    note "The tunnel is up and will be disconnected first."
  fi
  note "The clone at $clone is left alone."
  note ""
  read -r -p "Type 'uninstall' to confirm: " reply || reply=""
  [[ "$reply" == "uninstall" ]] || die "aborted"

  # Tear the tunnel down before the pidfile goes: otherwise openconnect keeps
  # running as root with no supported way left to stop it. cmd_off already
  # sorts a live tunnel from a stale pidfile, so the file existing is the
  # whole condition -- and it is re-checked here, not before the prompt,
  # because the tunnel can drop while the user is reading.
  if [[ -e "$PID_FILE" ]]; then
    cmd_off
  fi

  # Both are built as <xdg-dir>/um-vpn at the top of this script, so this
  # cannot fire today. It is a tripwire for a later edit that makes those
  # paths configurable, guarding the only irreversible thing um-vpn does.
  [[ "$STATE_DIR" == */um-vpn && "$DATA_DIR" == */um-vpn ]] ||
    die "refusing to remove unexpected paths"

  for link in "${links[@]}"; do
    rm -f "$link" || note "could not remove $link -- try: sudo rm $link"
  done
  rm -rf "$STATE_DIR" "$DATA_DIR"
  keyring_clear
  note "Removed."
  note ""

  # Deleting the cookie only revokes this machine's copy of the session.
  note "Your portal session stays valid until the gateway expires it."
  note "To end it now, open $PORTAL_URL in a browser and log out."
  note "The ADFS and Duo trust lived in the deleted profile and is gone."
  note ""
  note "Left in place:"
  note "  $clone  (the scripts themselves; delete it yourself)"
  note "  openconnect and vpnc-scripts -- other VPNs may need them:"
  note "    sudo apt remove openconnect vpnc-scripts"
}

# --- entry point ----------------------------------------------------------

# Print the header comment block, however long it happens to be: a hardcoded
# line range silently desynchronises from --help the first time it is edited.
usage() {
  awk '
    NR == 1 { next }
    !/^#/   { exit }
            { sub(/^# ?/, ""); print }
  ' "$SELF"
}

case "${1-toggle}" in
  toggle) if tunnel_pid >/dev/null; then cmd_off; else cmd_on; fi ;;
  on|up|connect) cmd_on ;;
  off|down|disconnect) cmd_off ;;
  status) cmd_status ;;
  renew|relogin) cmd_renew ;;
  credentials|creds) shift; cmd_credentials "$@" ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
